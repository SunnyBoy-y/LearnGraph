LEARNGRAPH_ENV=development
LEARNGRAPH_DATABASE_URL=sqlite:///./data/learngraph.db
LEARNGRAPH_STORAGE_ROOT=./data/storage
LEARNGRAPH_MEMORY_ROOT=./data/memory
# 前端通过 Vite 同源代理访问时不需要 CORS；若直接把 API 暴露到另一个端口并让
# 前端跨源调用，则需要把该前端公网 origin 加入此 JSON 数组。
LEARNGRAPH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Demo 演示数据默认开启（demo 工作区自带示例图谱/会话；仅开发/测试/本地 env 生效）；
# 显式设 false 可关闭。
LEARNGRAPH_ENABLE_DEMO_SEED=true
# Demo 登录默认开启（demo / learn-graph-local）；显式设 false 可关闭。
# 仅控制登录入口与演示身份；完整演示数据仍由 LEARNGRAPH_ENABLE_DEMO_SEED 控制。
LEARNGRAPH_ENABLE_DEMO_LOGIN=true
LEARNGRAPH_DEMO_USERNAME=demo
LEARNGRAPH_DEMO_PASSWORD=learn-graph-local

# 登录会话以哈希形式持久化，可独立撤销。
LEARNGRAPH_AUTH_SESSION_HOURS=12
LEARNGRAPH_AUTH_MAX_FAILED_LOGINS=5
LEARNGRAPH_AUTH_LOCKOUT_MINUTES=15
LEARNGRAPH_BOOTSTRAP_ADMIN_USERNAME=admin
# 留空时，首次启动会生成并输出一次高强度管理员密码。
LEARNGRAPH_BOOTSTRAP_ADMIN_PASSWORD=

# 本地演示模型默认关闭，只能用于显式开发演示，远程调用失败时不会自动回退。
LEARNGRAPH_ENABLE_LOCAL_DEMO_PROVIDER=false

# Provider API Key 默认由操作系统安全凭据库保护。
# 首次在页面保存 API Key 时会自动生成版本化主密钥，无需在 .env 中配置主密钥。
LEARNGRAPH_SECRET_PROVIDER=keyring
LEARNGRAPH_KEYRING_SERVICE_NAME=LearnGraph
LEARNGRAPH_KEYRING_ACCOUNT_PREFIX=master-key

# 掌握度任务、游标和租约持久化在 SQLite；内置调度循环仅适用于单进程本地 MVP。
LEARNGRAPH_MASTERY_MESSAGE_THRESHOLD=8
LEARNGRAPH_MASTERY_IDLE_SECONDS=300
LEARNGRAPH_MASTERY_EMBEDDED_SCHEDULER_ENABLED=true
LEARNGRAPH_MASTERY_SCHEDULER_INTERVAL_SECONDS=60
LEARNGRAPH_MASTERY_JOB_LEASE_SECONDS=300
LEARNGRAPH_MASTERY_JOB_MAX_ATTEMPTS=3

# Memory 保留期调度器会销毁已过恢复期的数据，即使当前没有用户访问 Memory API。
LEARNGRAPH_MEMORY_RETENTION_SCHEDULER_ENABLED=true
LEARNGRAPH_MEMORY_RETENTION_INTERVAL_SECONDS=60

# Docker 是跨平台加固沙箱基线。沙箱策略默认开启，但缺少可用镜像时不会执行任务。
# 用户可在页面初始化本地 Runner；镜像摘要保存到 data/sandbox-runtime.json。
# 统一镜像内置 Chromium/Playwright、ffmpeg、CJK 字体、vite/vue/react 工具链与
# learngraph_tasks 文档转换库；容器始终 network none。
# 镜像 digest 不需要手写：Bootstrap（页面「初始化本地 Runner」或
# scripts/bootstrap_sandbox_runtime.py）构建成功后会自动把新的不可变 digest
# 持久化到 data/sandbox-runtime.json，运行期自动读取（digest 每次构建都是新值，
# 写死会导致重建后镜像失效）。
# 仅 CI / 离线部署需要固定覆盖时才设置 LEARNGRAPH_SANDBOX_IMAGE（env 优先于持久化值）。
#
# 预构建沙箱镜像（推荐普通用户配置，有网即可拉取）：初始化时仅 pull，而不现场编译。
# Bootstrap 会将实际拉到的 RepoDigest 做冒烟检查后持久化，运行时始终使用该 immutable digest；
# 发布稳定后可直接填 @sha256:<digest> 形式。未配置则继续使用本地 Docker build fallback。
#
# 国内用户首选阿里云 ACR（公开仓库无需登录）：
#   crpi-a89c780kegywb9dg.cn-hangzhou.personal.cr.aliyuncs.com/learngraph/learngraph:<发布版本>
# 发布脚本：scripts/prepare_sandbox_acr_release.ps1（本地构建+冒烟后打 tag，再 docker push）。
# 国际用户可选 Docker Hub：
#   docker.io/<你的用户名>/learngraph-sandbox:<发布版本>
# 适用于 x86 Linux Docker Engine 和 Windows Docker Desktop 的 Linux containers 模式；
# ACR 个人版仅支持 linux/amd64，Apple Silicon 用户请保留本地构建 fallback。
# 不要将任何 registry 的 token 写入此文件。
LEARNGRAPH_SANDBOX_PREBUILT_IMAGE=crpi-a89c780kegywb9dg.cn-hangzhou.personal.cr.aliyuncs.com/learngraph/learngraph:1.0.0
LEARNGRAPH_SANDBOX_ENABLED=true
LEARNGRAPH_SANDBOX_BACKEND=docker
# 构建期镜像源覆盖（仅 Bootstrap 构建时使用；国内网络可指向镜像站）。
# 必须是 Docker daemon 可访问、包含本镜像所有固定直接/间接依赖的 HTTPS 源。
# 持续失败时检查 Bootstrap 日志中的包名/网络错误；修复镜像源或留空以使用 Dockerfile 的 PyPI/npm 默认值。
# 绝不影响运行期沙箱：容器始终 network none。
LEARNGRAPH_SANDBOX_BUILD_PIP_INDEX_URL=
LEARNGRAPH_SANDBOX_BUILD_NPM_REGISTRY=
LEARNGRAPH_SANDBOX_TASK_TTL_SECONDS=3600
LEARNGRAPH_SANDBOX_CONTAINER_IDLE_TTL_SECONDS=180
LEARNGRAPH_SANDBOX_CONTAINER_ABSOLUTE_TTL_SECONDS=1800
LEARNGRAPH_SANDBOX_WORKSPACE_IDLE_TTL_SECONDS=1800
LEARNGRAPH_SANDBOX_WORKSPACE_ABSOLUTE_TTL_SECONDS=86400
LEARNGRAPH_SANDBOX_WORKSPACE_ROOT=./data/sandbox-workspaces
LEARNGRAPH_SANDBOX_WALL_TIME_SECONDS=180
LEARNGRAPH_SANDBOX_CPU_COUNT=2
LEARNGRAPH_SANDBOX_MEMORY_BYTES=2147483648
LEARNGRAPH_SANDBOX_MEMORY_SWAP_BYTES=2147483648
# pids_limit 计入线程；统一镜像含 Chromium，需要比纯解释器更多的余量。
LEARNGRAPH_SANDBOX_PIDS_MAX=512
# 工作区聚合磁盘配额：宿主侧遍历整个会话目录求和（默认512MB）
LEARNGRAPH_SANDBOX_DISK_BYTES=536870912
# 单次任务返回给宿主的输出上限（stdout + artifact；默认256MB）
LEARNGRAPH_SANDBOX_OUTPUT_BYTES=268435456
LEARNGRAPH_SANDBOX_ACTIVE_PER_USER=2
LEARNGRAPH_SANDBOX_QUEUED_TASKS_PER_USER=5
LEARNGRAPH_SANDBOX_RETAINED_WORKSPACES_PER_USER=10
LEARNGRAPH_SANDBOX_HOST_MAX_ACTIVE=20
LEARNGRAPH_SANDBOX_HOST_MAX_ALLOCATED_MEMORY_RATIO=0.70
LEARNGRAPH_SANDBOX_HOST_MAX_ALLOCATED_CPU_RATIO=0.80
LEARNGRAPH_SANDBOX_HOST_MINIMUM_FREE_DISK_BYTES=21474836480

# Agent 代码工作区是加固 Docker 沙箱中的显式能力；命令仅接受 argv，
# 不经过 Shell，并限制为工作区内的 Python 脚本和可移植相对路径。
LEARNGRAPH_SANDBOX_AGENT_ENABLED=true
# 多文件教学子应用（subapp）预览的独立 Origin。必须与主 API Origin 不同：
# - 真实域名部署：填 https://preview.example.com（nginx/Caddy 反代到 preview 进程）。
# - 内网穿透/端口转发：手动把 preview 本地端口（默认 8001）映射到公网，并在此填
#   公网 origin（如 https://your-tunnel.example.com:23351）；只映射 5173 时
#   浏览器拿不到 http://127.0.0.1:8001 的预览资源。
# - 本地开发：留空即可；scripts/dev.mjs 会在 LEARNGRAPH_SUBAPP_PREVIEW_PORT
#   （默认 8001）自动启动 preview 进程，并按 http://127.0.0.1:<port> 推导。
# 留空且无 preview 端口时会 fail-closed（多文件 bundle 预览不可用）。
# 也可由部署管理员在前端「沙箱」设置页持久化配置（优先级：设置页 > 本 env > 本地端口推导）。
LEARNGRAPH_SUBAPP_PREVIEW_ORIGIN=
LEARNGRAPH_SUBAPP_PREVIEW_PORT=8001
# 子应用事件驱动 Agent 自动处理默认关闭。开启后仍需前端授权：
# 每个 interaction_contract.agent_triggers 声明的事件，在无白名单/全局允许时
# 会先向用户询问。开启可能触发真实模型计费。
LEARNGRAPH_SUBAPP_EVENT_AGENT_ENABLED=false
LEARNGRAPH_SUBAPP_EVENT_AGENT_MAX_ATTEMPTS=3
LEARNGRAPH_SUBAPP_EVENT_AGENT_IDLE_SECONDS=120
LEARNGRAPH_SUBAPP_EVENT_AGENT_POLL_RECONCILE=true
# Agent 工作区单文件写入上限（默认 1MB → 64MB；validator 上限 1GB）
LEARNGRAPH_SANDBOX_AGENT_FILE_BYTES=67108864
# 从沙箱容器读回文件/工作区列表的 tar archive 上限（默认 16MB → 1GB）
# 必须 ≥ max(output_bytes, disk_bytes) 才不会挡大文件读回
LEARNGRAPH_SANDBOX_AGENT_ARCHIVE_BYTES=1073741824
LEARNGRAPH_SANDBOX_AGENT_COMMAND_ARGS_MAX=32
LEARNGRAPH_SANDBOX_CLEANUP_SCHEDULER_ENABLED=true
LEARNGRAPH_SANDBOX_CLEANUP_INTERVAL_SECONDS=60

# 沙箱出站网络（P2-C）：默认开启。仍需每个工作区有效的 egress 策略文件
# （data/egress-policies/{workspace_id}.json）；无有效策略时容器保持离线。
# 代理仍对每个 CONNECT 重新分类，私网/环回/元数据地址始终拒绝。
LEARNGRAPH_SANDBOX_EGRESS_ENABLED=true
LEARNGRAPH_SANDBOX_EGRESS_POLICY_DIR=./data/egress-policies
LEARNGRAPH_SANDBOX_EGRESS_NETWORK=learngraph-egress
LEARNGRAPH_SANDBOX_EGRESS_PROXY_URL=http://egress-proxy:8888

# 通用 Agent Egress 审批通道（D2.1）：默认开启，用户可在设置页查看/审批
# Agent 出站主机请求。每次审批只放行精确主机名，egress 代理仍对每个 CONNECT
# 重新分类，私网/环回/元数据地址始终拒绝。
LEARNGRAPH_SANDBOX_AGENT_EGRESS_APPROVALS_ENABLED=true

# 沙箱隔离网页抓取（sandbox web fetch）：与 sandbox_egress_enabled 同时开启后，
# 页面抓取与不可信 HTML 解析在固定 web_fetch 容器内进行（绝不落在宿主进程）。
# 需要工作区非空 web_fetch.policy 白名单；否则回退到显式远程 FetchProvider /
# Qwen 伴生通道。默认关闭（opt-in）。
# LEARNGRAPH_SANDBOX_WEB_FETCH_ENABLED=true
# 单次抓取硬上限
# LEARNGRAPH_SANDBOX_WEB_FETCH_TIMEOUT_SECONDS=30
# LEARNGRAPH_SANDBOX_WEB_FETCH_MAX_BYTES=2097152
# 热容器池：容器按 工作区/白名单 复用，跳过每次抓取的创建/销毁开销，并支持
# 最多 pool_size 个抓取并发执行。0=关闭池，回退为每次抓取新建容器。
# 空闲超过 pool_idle_seconds 的容器会被回收（惰性 + 定时 sweep）。
LEARNGRAPH_SANDBOX_WEB_FETCH_POOL_SIZE=4
LEARNGRAPH_SANDBOX_WEB_FETCH_POOL_IDLE_SECONDS=600

# 系统代理 fake-ip（Clash 风格 198.18.x.x）会把公开域名解析成内网地址，
# 导致桥接 URL SSRF 校验拒绝 Firecrawl/SearXNG/云搜索。产品面向本机单用户、
# 受信主机网络，默认放开桥接地址解析校验（与代码默认值一致）；URL
# scheme/凭据/端口校验仍生效。多租户或公网暴露部署必须显式设为 false，
# 以保持私网地址 SSRF 护栏开启。
LEARNGRAPH_ALLOW_PRIVATE_BRIDGE_URLS=true

# MCP OAuth 动态客户端注册的受信 issuer 白名单（JSON 数组，默认空=关闭注册）。
# 例如：LEARNGRAPH_MCP_OAUTH_TRUSTED_ISSUERS=["https://auth.example.com"]
LEARNGRAPH_MCP_OAUTH_TRUSTED_ISSUERS=

# 平台普通文件上传上限（学习材料、zip 等；默认256MB）
LEARNGRAPH_MAX_UPLOAD_BYTES=268435456
