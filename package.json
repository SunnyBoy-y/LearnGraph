{
  "name": "learngraph-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Root-level development commands for the LearnGraph frontend and backend.",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:install": "node ./scripts/dev.mjs --install",
    "check": "node ./scripts/check.mjs",
    "check:install": "node ./scripts/check.mjs --install",
    "check:frontend": "node ./scripts/check.mjs --skip-backend",
    "check:backend": "node ./scripts/check.mjs --skip-frontend",
    "lint:frontend": "npm --prefix frontend run lint",
    "build:frontend": "npm --prefix frontend run build"
  }
}
