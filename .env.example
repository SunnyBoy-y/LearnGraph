# Optional Compose overrides. `npm run docker:up`（或 `node scripts/compose.mjs`）
# 会在首次启动时自动从本模板生成根目录 `.env`（幂等，绝不覆盖已有配置）；
# 手动复制 `copy .env.example .env` 亦可。Copy to `.env` next to docker-compose.yml.
# Full backend knobs live in backend/.env.example.
#
# 默认只绑定 127.0.0.1 且用高位端口（18000/18001），避免与常见开发端口撞车；
# 公网/局域网部署时设 LEARNGRAPH_LISTEN_HOST=0.0.0.0 并自行选定端口
# （与 `npm run dev -- --lan` 的语义一致）。

LEARNGRAPH_LISTEN_HOST=127.0.0.1
LEARNGRAPH_PORT=18000
LEARNGRAPH_PREVIEW_PORT=18001
LEARNGRAPH_ENV=development
LEARNGRAPH_DEPLOYMENT_PROFILE=self_hosted_team
LEARNGRAPH_BOOTSTRAP_ADMIN_PASSWORD=
LEARNGRAPH_MASTER_KEY=
LEARNGRAPH_SUBAPP_PREVIEW_ORIGIN=http://127.0.0.1:18001
LEARNGRAPH_CORS_ORIGINS=["http://127.0.0.1:18000","http://localhost:18000"]
LEARNGRAPH_IMAGE=learngraph:local

# 宿主服务访问策略（整体 Docker 部署访问本机 Ollama/LM Studio/本地 MCP 的方式）：
#   auto    默认：容器化 profile 自动走 Host Service Bridge（需宿主机启动
#           `node scripts/host-bridge.mjs` 并注册服务）
#   direct  可信桌面直连：容器内 loopback 地址改写为 host.docker.internal:同端口，  
#           无需 Bridge/token/注册/审计；仅建议 Windows/macOS Docker Desktop
#           个人可信环境（Linux 需宿主服务监听网关可达接口）
#   bridge  强制走 Host Service Bridge
#   off     关闭全部宿主服务改写
LEARNGRAPH_HOST_ACCESS_MODE=auto

# Linux sandbox override (docker-compose.sandbox.yml) —— sandboxd 控制面
# 新架构下 Docker socket 只挂给 sandboxd，app 不再直接控制 Docker。
#   mkdir -p secrets
#   openssl rand -hex 32 > secrets/sandboxd-token
#   openssl rand -hex 32 > secrets/sandboxd-admin-token   # bootstrap 管理面（pull+digest+smoke）
#   docker compose -f docker-compose.yml -f docker-compose.sandbox.yml up -d
LEARNGRAPH_DATA_DIR=/var/lib/learngraph
DOCKER_GID=998
# LEARNGRAPH_SANDBOXD_TOKEN_FILE=./secrets/sandboxd-token
# LEARNGRAPH_SANDBOXD_ADMIN_TOKEN_FILE=./secrets/sandboxd-admin-token
# LEARNGRAPH_SANDBOXD_DEPLOYMENT_ID=learngraph-compose
# LEARNGRAPH_SANDBOX_IMAGE=sha256:<digest>   # 可选：固定 runner 镜像 digest（不设则需通过 sandboxd bootstrap 安装）
# LEARNGRAPH_SANDBOX_PREBUILT_IMAGE=<registry>/<image>:<tag>   # bootstrap 拉取并冒烟固定的 prebuilt 镜像

# 主 compose（仅 docker-compose.yml）已内置 sandboxd 控制面：app 容器经内部
# 网络 http://sandboxd:8090 访问，服务/admin 凭据由 sandboxd 首启时自举写入
# 共享卷（sandboxd-state），无需宿主生成 token、无需 Node 环境。要自定义：
# LEARNGRAPH_SANDBOXD_URL=http://sandboxd:8090
# LEARNGRAPH_SANDBOXD_DEPLOYMENT_ID=learngraph-compose
# 加固形态（compose secrets 手动凭据 + internal 网络）继续用
# docker-compose.sandbox.yml 叠加，见上方 Linux sandbox override 段落。

# 沙箱审批制出网由 compose 内置 egress-proxy 服务接线（内部网络 learngraph-egress
# 由 compose 自动创建并固定网络名）。若你曾手动 `docker network create
# learngraph-egress`，请先删除该网络再 `docker compose up`，避免名称冲突。
# 代理监听与审计等参数见 backend/.env.example 的 EGRESS 段。
