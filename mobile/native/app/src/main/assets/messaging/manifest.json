{
  "manifest_version": 2,
  "name": "LearnGraph Native Bridge",
  "version": "1.0",
  "description": "LearnGraph 网页版与原生壳的双向通信桥（GeckoView 内嵌内核）",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
