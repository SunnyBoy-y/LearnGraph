{
  "name": "learngraph-mobile",
  "private": true,
  "version": "0.18.4",
  "type": "module",
  "description": "LearnGraph Android 原生客户端：Compose 聊天、本地缓存、条件同步与系统 WebView 功能兼容",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "apk:debug": "node scripts/android-build.mjs debug",
    "apk:compact": "node scripts/android-build.mjs compact",
    "apk:release": "node scripts/android-build.mjs release",
    "test:native": "node scripts/android-build.mjs test",
    "build:renderer": "node scripts/build-native-renderer.mjs",
    "apk:legacy": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
